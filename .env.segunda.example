# =========================================================================
#  SEGUNDA INSTANCIA  -  otro bot, contra OTRA cuenta de MetaTrader
# =========================================================================
#
#  Copiá este archivo como  .env.segunda  y completalo.
#  Se arranca con:  scripts\iniciar_segunda.bat
#
#  POR QUE UN ARCHIVO APARTE Y NO UNA OPCION
#  -----------------------------------------
#  MetaTrader admite UNA cuenta por terminal, y el paquete de Python admite
#  UNA terminal por proceso. Dos cuentas simultaneas son entonces dos
#  MetaTrader abiertos y dos procesos del bot, cada uno con su configuracion.
#  No hay forma de que un solo bot opere dos cuentas a la vez.
#
#  PRIMERO: HAY QUE TOCAR TAMBIEN EL .env PRINCIPAL
#  ------------------------------------------------
#  Abri tu .env de siempre y asegurate de que tenga la MISMA linea
#  INSTANCE_NAMES que este archivo:
#
#      INSTANCE_NAMES=demo,fxpro
#
#  Sin eso, el bot principal no reconoce el nombre del segundo, y un
#  "/pausa fxpro" desde Telegram no le llega a nadie: la instancia principal
#  lo lee como texto libre y se pausa a si misma.
#
#  Los dos arranques imprimen su lista al lado del nombre. Si no coinciden,
#  se ve ahi.
#
#
#  LAS CINCO COSAS QUE TIENEN QUE SER DISTINTAS
#  --------------------------------------------
#  Si alguna queda igual que en el .env principal, los dos bots se pisan.
#  Estan marcadas con  <<< DISTINTO >>>  aca abajo.
#
#      1. INSTANCE_NAME          como se llama este
#      2. TELEGRAM_SESSION_NAME  su sesion de Telegram
#      3. DATA_DIR y las rutas   su carpeta de datos
#      4. LOG_PATH               su archivo de log
#      5. MT5_PATH               SU terminal de MetaTrader
#
#  El bot se niega a arrancar si dos procesos comparten la carpeta de datos,
#  asi que el punto 3 no se puede olvidar en silencio. Los otros si.


# -------------------------------------------------------------------------
# 1) IDENTIDAD
# -------------------------------------------------------------------------
# La lista COMPLETA de instancias que corren. Tiene que ser IDENTICA en todos
# los .env: cada bot necesita reconocer los nombres de los otros para saber
# que un "/pausa fxpro" no es para el.
#
# Nombres libres, una sola palabra, sin espacios ni guiones. Poneles el nombre
# del broker, que es lo que despues vas a querer escribir en Telegram.
INSTANCE_NAMES=demo,fxpro

# Cual de esos es ESTE bot.                              <<< DISTINTO >>>
INSTANCE_NAME=fxpro


# -------------------------------------------------------------------------
# 2) TELEGRAM
# -------------------------------------------------------------------------
# Mismas credenciales que el .env principal: es la misma cuenta tuya leyendo
# el mismo grupo. Copialas tal cual de tu .env.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SOURCE_CHATS=

# Pero la SESION tiene que ser otro archivo.             <<< DISTINTO >>>
# Dos procesos sobre la misma sesion de Telethon se desconectan mutuamente.
TELEGRAM_SESSION_NAME=telegram_copy_trading_fxpro

# Notificaciones. Podes usar el mismo bot y el mismo chat: cada mensaje viene
# firmado con [FXPRO] o [DEMO], asi que se distinguen solos.
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=


# -------------------------------------------------------------------------
# 3) CARPETA DE DATOS                                    <<< DISTINTO >>>
# -------------------------------------------------------------------------
# Cada instancia lleva su propio historial y su propio estado. Compartirlos
# hace que un bot borre las posiciones del otro, y una posicion que
# desaparece del estado queda abierta en MetaTrader sin que nadie la conozca.
#
# El bot verifica esto al arrancar y se niega si estan compartidas.
DATA_DIR=data/fxpro
PAPER_TRADES_PATH=data/fxpro/paper_trades.jsonl
EVENTS_PATH=data/fxpro/events.jsonl
STATE_PATH=data/fxpro/state.json
LOG_PATH=logs/tct-fxpro.log


# -------------------------------------------------------------------------
# 4) LA CUENTA DE METATRADER                             <<< DISTINTO >>>
# -------------------------------------------------------------------------
# ACA ESTA LO QUE MAS FACIL SE ROMPE.
#
# MT5_PATH tiene que apuntar al terminal64.exe de la instalacion de MetaTrader
# de ESTA cuenta. Con una sola instancia se puede dejar vacio y el bot se
# engancha a la que encuentre; con dos, "la que encuentre" no tiene una
# respuesta correcta y los dos bots pueden terminar en la misma cuenta.
#
# Para encontrar la ruta: clic derecho en el acceso directo de ese MetaTrader
# -> Propiedades -> "Destino".
MT5_PATH=

TRADING_MODE=AUTO
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Verifica SIEMPRE la linea del arranque antes de dejarlo corriendo:
#     MT5 listo | servidor=XXX balance=YYY
# Esa linea dice contra que cuenta esta por operar de verdad.


# -------------------------------------------------------------------------
# 5) RIESGO
# -------------------------------------------------------------------------
# Pueden ser distintos de los del otro bot, y de hecho tiene sentido que lo
# sean: dos brokers no tienen los mismos lotes minimos ni los mismos spreads.
DEFAULT_LOT=0.01
MAX_LOT=0.01
MAX_OPEN_TRADES=5
MAX_SIGNALS_PER_DAY=10
REQUIRE_STOP_LOSS=true
REQUIRE_TAKE_PROFIT=true
MAX_SPREAD_FROM_ENTRY_PCT=0.5
MAX_PENDING_DISTANCE_PCT=3.0
MAX_DAILY_LOSS_PCT=0
ALLOW_LIVE_TRADING=false

# La lista de simbolos puede diferir: no todos los brokers tienen los mismos.
# Corre 'tct probar --env-file .env.segunda' para ver cuales expone este.
ALLOWED_SYMBOLS=XAUUSD,XAGUSD,EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,NAS100,US30,US500


# -------------------------------------------------------------------------
# 6) IA LOCAL
# -------------------------------------------------------------------------
# Ollama es un servicio suelto: los dos bots pueden usar el mismo sin
# molestarse. No hace falta instalar nada de nuevo.
ENABLE_OLLAMA=true
OLLAMA_MODEL=llama3.2:3b
OLLAMA_AUTO_EXECUTE=false

DRY_RUN=false
ENABLE_TELEGRAM_CONTROL=true
TELEGRAM_CONTROL_CHAT=me
