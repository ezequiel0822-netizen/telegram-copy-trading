# =========================================================================
#  Telegram Copy Trading - configuracion
#
#  Copiá este archivo a `.env` y completá los valores:
#      cp .env.example .env
#
#  El archivo `.env` NUNCA se sube a git (está en .gitignore): contiene
#  credenciales que dan acceso a tu cuenta de Telegram y a la cuenta de MT5.
# =========================================================================


# -------------------------------------------------------------------------
# 1) MODO DE OPERACION
# -------------------------------------------------------------------------
#   AUTO                    (por defecto) El sistema decide solo: si abajo hay
#                           credenciales de MetaApi, ejecuta en tu cuenta MT5
#                           demo; si no las hay, corre solo en papel.
#                           Pasar de papel a MT5 demo es completar dos
#                           variables en la seccion 4 y reiniciar. No hay que
#                           instalar nada ni cambiar este valor.
#
# Y si preferis fijarlo a mano en vez de dejarlo en AUTO:
#
#   PAPER_ONLY              Solo registra operaciones simuladas, aunque haya
#                           credenciales cargadas. Util para volver a papel
#                           sin borrar nada.
#   PAPER_AND_METAAPI_DEMO  Fuerza la ejecucion en MT5 demo via MetaApi.
#                           Falla al arrancar si faltan las credenciales.
#   PAPER_AND_MT5_DEMO      Ejecuta con el MT5 instalado localmente.
#                           SOLO WINDOWS. En Mac el arranque falla a proposito.
#   LIVE                    Dinero real. Necesita ademas ALLOW_LIVE_TRADING=true.
TRADING_MODE=AUTO

# Observar sin operar: parsea y registra en events.jsonl, pero no crea ni
# siquiera operaciones en papel. Sirve para mirar durante unos dias como
# interpreta el bot los mensajes de un grupo nuevo, sin comprometerse a nada.
DRY_RUN=false


# -------------------------------------------------------------------------
# 2) TELEGRAM - LEER EL GRUPO DE SENALES  (obligatorio)
# -------------------------------------------------------------------------
# Se entra como TU CUENTA de usuario, no como un bot: un bot necesitaria que
# un admin del grupo lo agregue, y en un grupo ajeno eso no va a pasar.
#
# Como conseguir API_ID y API_HASH (gratis, 2 minutos):
#   1. Entrá a https://my.telegram.org
#   2. Logueate con tu numero de telefono
#   3. "API development tools" -> creá una app (cualquier nombre sirve)
#   4. Copiá "App api_id" y "App api_hash" aca abajo
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Nombre del archivo de sesion. La PRIMERA vez que corras el bot te va a pedir
# el telefono y un codigo de verificacion, y despues guarda `<nombre>.session`.
# Ese archivo ES una credencial: da acceso a tu Telegram. No lo compartas.
TELEGRAM_SESSION_NAME=telegram_copy_trading

# IDs de los grupos/canales a escuchar, separados por coma.
# Para saber cuales son, corré:   python -m tct chats
# Ejemplo: TELEGRAM_SOURCE_CHATS=-1001234567890,-1009876543210
TELEGRAM_SOURCE_CHATS=


# -------------------------------------------------------------------------
# 3) TELEGRAM - RECIBIR AVISOS DEL BOT  (opcional pero muy recomendado)
# -------------------------------------------------------------------------
# Un bot propio que te escribe cuando toma o rechaza una senal, asi no hay que
# mirar los logs. Si lo dejás vacio, el sistema funciona igual y solo se
# pierden los avisos.
#
#   1. En Telegram, hablale a @BotFather -> /newbot -> copiá el token
#   2. Escribile algo a TU bot nuevo (si no, no puede contestarte)
#   3. Para el chat id, hablale a @userinfobot: te dice tu ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=


# -------------------------------------------------------------------------
# 4) METAAPI - OPERAR EN TU CUENTA MT5 DEMO
# -------------------------------------------------------------------------
# ESTO ES LO UNICO QUE SEPARA EL MODO PAPEL DE LA CUENTA DEMO.
#
# El puente ya viene instalado. Con TRADING_MODE=AUTO, apenas completes estas
# dos variables y reinicies, el bot deja de operar solo en papel y empieza a
# mandar las ordenes a tu cuenta MT5 demo. No hay que instalar ni cambiar
# nada mas. Si las dejas vacias, sigue en papel sin quejarse.
#
# Existe porque el paquete MetaTrader5 de Python no funciona en macOS:
# MetaApi hostea el terminal MT5 en su nube y lo expone por internet, con lo
# cual el sistema operativo deja de importar.
#
#   1. Crea una cuenta en https://app.metaapi.cloud
#   2. Genera un token en la seccion de tokens
#   3. Agrega tu cuenta MT5 DEMO (login, password, servidor del broker)
#   4. Copia el Account ID que te da MetaApi
#
# El sistema RECHAZA cualquier cuenta que el broker no reporte como demo,
# aunque la configures mal por error.
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
METAAPI_REGION=new-york


# -------------------------------------------------------------------------
# 5) MT5 NATIVO  (solo si TRADING_MODE=PAPER_AND_MT5_DEMO, y solo en Windows)
# -------------------------------------------------------------------------
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Ruta al terminal64.exe. Vacio = usa el MT5 que ya este abierto.
MT5_PATH=

# Perfil del broker, para traducir los nombres de los simbolos.
# Opciones: default, icmarkets, pepperstone, exness, roboforex, fxpro,
#           tickmill, fbs, metaquotes, icmarkets_raw
# Ejemplo: con "exness", XAUUSD se manda como XAUUSDm.
MT5_BROKER_PROFILE=default


# -------------------------------------------------------------------------
# 6) RIESGO  (todas estas protecciones son editables a proposito)
# -------------------------------------------------------------------------
# Lote de cada operacion. 0.01 es el minimo en casi todos los brokers.
DEFAULT_LOT=0.01

# Techo duro. Si DEFAULT_LOT lo supera, el bot no arranca.
MAX_LOT=0.01

# Lista blanca de instrumentos. Cualquier senal de un simbolo que no este aca
# se rechaza y queda registrada como rechazo.
ALLOWED_SYMBOLS=XAUUSD,XAGUSD,EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,NAS100,US30,US500

# Maximo de operaciones abiertas al mismo tiempo.
MAX_OPEN_TRADES=5

# Tope de senales por dia. Frena a un grupo que empieza a mandar 50 senales.
MAX_SIGNALS_PER_DAY=20

# Rechazar senales sin stop loss / sin take profit.
# Bajar REQUIRE_STOP_LOSS a false es peligroso: deja operaciones sin proteccion.
REQUIRE_STOP_LOSS=true
REQUIRE_TAKE_PROFIT=true

# Ultima barrera antes del dinero real. Con esto en false, el bot rechaza
# cualquier cuenta que el broker no reporte como demo, incluso en modo LIVE.
ALLOW_LIVE_TRADING=false


# -------------------------------------------------------------------------
# 7) OCR - SENALES DENTRO DE IMAGENES  (opcional, apagado)
# -------------------------------------------------------------------------
# El lado Python ya viene instalado. El instalador ademas intenta poner el
# motor Tesseract si encuentra Homebrew; si no, se agrega con:
#     brew install tesseract
#
# Recomendacion: dejarlo en false hasta ver cuantas senales del grupo son
# realmente solo imagen. Un OCR que lee mal un digito de un precio es peor
# que no leer nada: produce una operacion con numeros inventados en vez de un
# rechazo visible. Los stickers se descartan siempre, incluso con esto en true.
ENABLE_OCR=false


# -------------------------------------------------------------------------
# 8) IA LOCAL (Ollama) - solo para mensajes que el parser NO entiende
# -------------------------------------------------------------------------
# Es un respaldo, no el camino principal. Si el grupo escribe con un formato
# reconocible, el parser de reglas resuelve solo y la IA ni se entera.
#
# Corre en TU maquina: es gratis, no manda nada a internet y no necesita
# cuenta en ningun lado.
#
# Instalar:   https://ollama.com/download
#             ollama pull qwen2.5:7b
ENABLE_OLLAMA=false

# Modelo a usar. El tamano importa MUCHO si la PC no tiene placa de video.
#
# Medido sobre un procesador de 8 nucleos sin GPU, con este mismo prompt:
#   llama3.2:3b   (2 GB)  -> ~25 segundos por mensaje.  RECOMENDADO.
#   qwen2.5:3b    (2 GB)  -> similar, suele leer mejor el espanol.
#   modelos 7B/8B (5 GB)  -> VARIOS MINUTOS. No es practico sin GPU.
#
# Que sea un modelo chico no es tan grave como suena: la tarea es acotada
# (sacar 5 datos de un mensaje corto) y el schema le fuerza el formato. Ademas
# todo numero que devuelve se verifica contra el mensaje original, y de todas
# formas la IA no opera sola.
#
# Si la PC tiene placa de video NVIDIA, ahi si vale un 7B: es varias veces
# mas rapido y lee mejor.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434

# Cuanto esperar una respuesta antes de darse por vencido. Generoso a
# proposito: si se corta por tiempo, el bot pierde la senal en silencio.
# Con un 3B alcanza y sobra; subilo si usas un modelo mas grande.
OLLAMA_TIMEOUT_SECONDS=180

# DEJAR EN false.
#
# Con false, lo que la IA interpreta se te avisa por Telegram y ahi termina:
# no abre ninguna operacion. Con true, opera igual que el parser de reglas.
#
# La razon de que el default sea false es concreta: las validaciones de riesgo
# verifican que un precio sea COHERENTE, no que sea el CORRECTO. Si el modelo
# lee 2345 donde decia 2355, la senal pasa todos los controles y opera con un
# numero inventado. Perderse una senal es barato; operar una equivocada, no.
#
# Antes de tocar esto, mira unas semanas de eventos "ia_sugerencia" en
# data/events.jsonl y fijate cuantas veces acerto de verdad.
OLLAMA_AUTO_EXECUTE=false


# -------------------------------------------------------------------------
# 9) ARCHIVOS  (no hace falta tocar nada de aca)
# -------------------------------------------------------------------------
DATA_DIR=data
PAPER_TRADES_PATH=data/paper_trades.jsonl
EVENTS_PATH=data/events.jsonl
STATE_PATH=data/state.json
LOG_PATH=logs/tct.log
