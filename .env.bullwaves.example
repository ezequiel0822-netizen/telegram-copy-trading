# =========================================================================
#  DEMO DE BULLWAVES  -  el ensayo de la cuenta real
# =========================================================================
#
#  Copiala a `.env.bullwaves`:  copy .env.bullwaves.example .env.bullwaves
#  Revisala con:                tct check --env-file .env.bullwaves
#  Y arrancala con:             scripts\iniciar_bullwaves.bat
#
#  POR QUE EXISTE
#  --------------
#  La demo de FxPro ensayo la estrategia con los precios, el spread y la
#  ejecucion de FxPro, y la real va en Bullwaves. Esta demo corre el MISMO bot
#  con los MISMOS numeros que .env.real, contra una cuenta demo de Bullwaves:
#  lo que haga aca es lo que va a hacer la real. Pidio probarla antes de
#  fondear (28/09).
#
#  ES TEMPORAL, Y COMPARTE EL METATRADER DE BULLWAVES CON LA REAL
#  -------------------------------------------------------------
#  MetaTrader tiene UNA cuenta por terminal. Esta demo usa la terminal de
#  Bullwaves logueada en la cuenta DEMO; la real, la misma terminal logueada en
#  la cuenta REAL. Por eso no corren a la vez: el bot real no arranca mientras
#  exista este archivo con la misma MT5_PATH (lo frena a proposito).
#
#  Para pasar a la real, cuando la demo haya andado bien:
#      1. Cerrar la ventana de este bot.
#      2. Retirar este archivo:   ren .env.bullwaves .env.bullwaves.retirada
#      3. Seguir la lista del dia de fondear (docs/CONTEXTO_MAESTRO.md).
#  Sus datos quedan en data\bullwaves para comparar con la real.
#
#  HAY QUE TOCAR TAMBIEN LOS OTROS .env
#  ------------------------------------
#  INSTANCE_NAMES tiene que ser IDENTICA en todos los .env (el de MetaQuotes,
#  .env.segunda y .env.real):
#      tct cambiar --env-file .env INSTANCE_NAMES=demo,fxpro,bullwaves,real
#      tct cambiar --env-file .env.segunda INSTANCE_NAMES=demo,fxpro,bullwaves,real
#      tct cambiar --env-file .env.real INSTANCE_NAMES=demo,fxpro,bullwaves,real


# -------------------------------------------------------------------------
# 1) IDENTIDAD Y SEPARACION  (distinto de los otros bots)
# -------------------------------------------------------------------------
TRADING_MODE=PAPER_AND_MT5_DEMO
ALLOW_LIVE_TRADING=false

INSTANCE_NAMES=demo,fxpro,bullwaves,real
INSTANCE_NAME=bullwaves

DATA_DIR=data/bullwaves
PAPER_TRADES_PATH=data/bullwaves/paper_trades.jsonl
EVENTS_PATH=data/bullwaves/events.jsonl
STATE_PATH=data/bullwaves/state.json
LOG_PATH=logs/tct-bullwaves.log

# Sesion de Telegram propia: la primera vez pide el codigo. Corre antes
#     tct chats --env-file .env.bullwaves
TELEGRAM_SESSION_NAME=telegram_copy_trading_bullwaves


# -------------------------------------------------------------------------
# 2) TELEGRAM  (los mismos datos que en los otros .env)
# -------------------------------------------------------------------------
# Se ponen con tct cambiar; el hash, sin '=' y sin valor (lo pide aparte):
#     tct cambiar --env-file .env.bullwaves TELEGRAM_API_ID=<id> TELEGRAM_SOURCE_CHATS=<chat> TELEGRAM_API_HASH
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SOURCE_CHATS=

# Igual que la real: no escucha comandos, se frena cerrando su ventana.
TELEGRAM_CONTROL_CHAT=me
ENABLE_TELEGRAM_CONTROL=false

# Opcional en una demo. Si la queres:  tct clave --env-file .env.bullwaves
CLAVE_DE_ARRANQUE=


# -------------------------------------------------------------------------
# 3) LA CUENTA DEMO DE BULLWAVES
# -------------------------------------------------------------------------
# En el MetaTrader de Bullwaves: Archivo -> Abrir una cuenta -> DEMO, del
# mismo tipo que vas a abrir en real, HEDGING, y con el saldo y el
# apalancamiento parecidos a los de la real (500) para que el margen sea el
# mismo. Logueala tildando "Guardar contrasena", y Algo Trading en verde.
#
# Despues, en este orden (tct mt5 se conecta a la terminal de MT5_PATH):
#   1. La ruta: clic derecho en el acceso directo del MetaTrader de Bullwaves
#      -> Propiedades -> copiar 'Destino', y pegarlo pegado al '=':
#          tct cambiar --env-file .env.bullwaves MT5_PATH=
#   2. tct mt5 --env-file .env.bullwaves
#      Tiene que decir DEMO, HEDGING, "XAUUSD -> ..." y cuantas entran.
#   3. tct cambiar --env-file .env.bullwaves MT5_LOGIN=<login> "MT5_SERVER=<servidor>" MT5_PASSWORD
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_BROKER_PROFILE=bullwaves


# -------------------------------------------------------------------------
# 4) RIESGO  -  LOS MISMOS NUMEROS QUE .env.real
# -------------------------------------------------------------------------
# Es el punto de esta demo. Si cambias alguno en .env.real, cambialo aca.
DEFAULT_LOT=0.05
MAX_LOT=0.05
POSITIONS_PER_SIGNAL=1
MAX_POSITIONS_PER_SYMBOL=2
MAX_OPEN_TRADES=2
MAX_SIGNALS_PER_DAY=5
MAX_DAILY_LOSS_PCT=0
REQUIRE_STOP_LOSS=true
REQUIRE_TAKE_PROFIT=true
BREAKEVEN_USES_REAL_ENTRY=true
MAX_SPREAD_FROM_ENTRY_PCT=0.05
MAX_PENDING_DISTANCE_PCT=2.0
# El SL del canal, tal cual (decision del 28/09).
MAX_STOP_DISTANCE_PCT=0
ALLOWED_SYMBOLS=XAUUSD


# -------------------------------------------------------------------------
# 5) IA LOCAL  (igual que la real: solo avisa, nunca opera)
# -------------------------------------------------------------------------
ENABLE_OLLAMA=true
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_AUTO_EXECUTE=false

DRY_RUN=false
