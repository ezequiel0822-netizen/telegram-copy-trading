# =========================================================================
#  CONFIGURACION DE LA CUENTA REAL
#
#  Copiala a `.env.real`:      copy .env.real.example .env.real
#  Y arrancala con:            scripts\iniciar_real.bat
#
#  Es un archivo APARTE del .env de la demo a proposito. Con dos archivos
#  distintos no existe la posibilidad de mezclar las credenciales por error,
#  y podes correr las dos cuentas al mismo tiempo sin que se pisen.
# =========================================================================


# -------------------------------------------------------------------------
# 1) LAS DOS LLAVES DEL DINERO REAL
# -------------------------------------------------------------------------
# Hacen falta las DOS. Son dos a proposito: nadie llega a dinero real por
# equivocarse en una sola linea.
#
# Con ALLOW_LIVE_TRADING=false, el bot RECHAZA cualquier cuenta que el broker
# no reporte como demo, aunque el modo diga LIVE. Esa barrera vive dentro del
# ejecutor de ordenes, no aca.
TRADING_MODE=LIVE
ALLOW_LIVE_TRADING=true

# Nombre de esta instancia. Es como le hablas por Telegram:  /pausa real
# Solo se aceptan: demo, real, papel, paper
INSTANCE_NAME=real


# -------------------------------------------------------------------------
# 2) SEPARACION DE LA DEMO  (no toques esto sin entender por que esta)
# -------------------------------------------------------------------------
# Carpeta de datos propia. Sin esto, las operaciones de la real y las de la
# demo se escribirian en los mismos archivos y el historial quedaria inservible
# para saber que hizo cada una.
DATA_DIR=data/real
PAPER_TRADES_PATH=data/real/paper_trades.jsonl
EVENTS_PATH=data/real/events.jsonl
STATE_PATH=data/real/state.json
LOG_PATH=logs/tct-real.log

# Sesion de Telegram propia. Dos procesos NO pueden compartir el mismo archivo
# .session: se corrompe. La primera vez va a pedir el codigo de nuevo.
TELEGRAM_SESSION_NAME=telegram_copy_trading_real


# -------------------------------------------------------------------------
# 3) TELEGRAM  (los mismos datos que en el .env de la demo)
# -------------------------------------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SOURCE_CHATS=

# Donde escuchar los comandos (/pausa, /estado...).
# "me" son tus Mensajes Guardados: privado y sin configurar nada.
TELEGRAM_CONTROL_CHAT=me
ENABLE_TELEGRAM_CONTROL=true

# Avisos. Con dinero real conviene tenerlos activados.
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=


# -------------------------------------------------------------------------
# 4) LA CUENTA REAL DE MT5
# -------------------------------------------------------------------------
# Corre scripts\datos_mt5.bat con la terminal de la cuenta REAL abierta para
# que te diga estos valores exactos.
#
# OJO: la contrasena master, no la inversora.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_BROKER_PROFILE=default


# -------------------------------------------------------------------------
# 5) RIESGO  -  ACA ES DONDE SE DECIDE CUANTO PODES PERDER
# -------------------------------------------------------------------------
# Estos numeros son deliberadamente mas conservadores que los de la demo.
# En la demo un error cuesta un numero en una pantalla; aca cuesta plata.

# Lote de cada operacion. Arranca en el minimo y subilo solo despues de ver
# varias semanas de resultados reales.
DEFAULT_LOT=0.01

# Techo duro. Si DEFAULT_LOT lo supera, el bot NO ARRANCA.
# Dejalo igual a DEFAULT_LOT hasta que tengas motivos para moverlo.
MAX_LOT=0.01

# Menos posiciones simultaneas que en la demo: limita cuanto puede doler un
# mal dia del grupo de senales.
MAX_OPEN_TRADES=2

# Menos senales por dia. Si el grupo se desboca, esto lo frena.
MAX_SIGNALS_PER_DAY=5

# EL FRENO MAS IMPORTANTE DE TODOS.
# Si la cuenta cae este % respecto del balance con el que abrio el dia, el bot
# deja de abrir operaciones hasta el dia siguiente. 0 = sin tope.
# No lo dejes en 0 con dinero real.
MAX_DAILY_LOSS_PCT=3

# Nunca operar sin stop loss. Con dinero real esto no se discute.
REQUIRE_STOP_LOSS=true
REQUIRE_TAKE_PROFIT=true

# Cuanto puede alejarse la entrada del mensaje del precio REAL del
# instrumento antes de rechazar la senal, en porcentaje.
#
# Es la unica proteccion que ataja un error de LECTURA. Las demas verifican
# que la senal sea coherente consigo misma, y un mensaje mal leido lo es: si
# el bot entiende "oro, entrada 2345, stop 2335" con el oro en 4438, el stop
# esta del lado correcto y la operacion se abre, con dos mil puntos de riesgo.
#
# Con dinero real conviene dejarlo mas ajustado que en la demo.
MAX_SPREAD_FROM_ENTRY_PCT=0.3

# Lo mismo para las ordenes pendientes, que se ponen lejos del mercado a
# proposito y necesitan mas aire.
MAX_PENDING_DISTANCE_PCT=2.0

# Empeza con pocos simbolos: los que ya viste funcionar en la demo.
ALLOWED_SYMBOLS=XAUUSD,EURUSD


# -------------------------------------------------------------------------
# 6) IA LOCAL
# -------------------------------------------------------------------------
# Con dinero real, OLLAMA_AUTO_EXECUTE se queda en false. Sin excepciones.
# La IA avisa por Telegram y vos decidis.
ENABLE_OLLAMA=true
OLLAMA_MODEL=llama3.2:3b
OLLAMA_AUTO_EXECUTE=false

# Arrancar observando sin operar. Poner en true los primeros dias de la real
# es la forma barata de confirmar que todo se comporta como esperas.
DRY_RUN=false
