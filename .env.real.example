# =========================================================================
#  CONFIGURACION DE LA CUENTA REAL
#
#  Copiala a `.env.real`:      copy .env.real.example .env.real
#  Revisala con:               tct check --env-file .env.real
#  Y arrancala con:            scripts\iniciar_real.bat
#
#  Es un archivo APARTE de los de la demo a proposito: con credenciales,
#  carpeta de datos y sesion propias no hay forma de mezclar la plata real con
#  los datos de la demo.
# =========================================================================


# -------------------------------------------------------------------------
# 1) LAS DOS LLAVES DEL DINERO REAL
# -------------------------------------------------------------------------
# Hacen falta LAS DOS, y con una sola el bot no arranca:
#
#   TRADING_MODE=LIVE sin ALLOW_LIVE_TRADING=true   -> error al arrancar
#   ALLOW_LIVE_TRADING=true sin TRADING_MODE=LIVE   -> error al arrancar
#
# La segunda regla existe porque la primera sola no alcanzaba: con AUTO y las
# credenciales de una cuenta real, el bot la operaba creyendo que era demo.
TRADING_MODE=LIVE
ALLOW_LIVE_TRADING=true

# Como se llama esta instancia: es lo que escribis en Telegram (/pausa real).
INSTANCE_NAME=real

# La lista de TODAS las instancias que corren. Tiene que ser IDENTICA en todos
# los .env activos. La real va en Bullwaves, con su propio MetaTrader, asi que
# las dos demos (MetaQuotes y FxPro) pueden seguir corriendo al lado.
INSTANCE_NAMES=demo,fxpro,real


# -------------------------------------------------------------------------
# 2) SEPARACION DE LA DEMO  (no toques esto sin entender por que esta)
# -------------------------------------------------------------------------
# Carpeta de datos propia. Sin esto, las operaciones de la real y las de la
# demo se escribirian en los mismos archivos y el historial quedaria inservible
# para saber que hizo cada una.
DATA_DIR=data/real
PAPER_TRADES_PATH=data/real/paper_trades.jsonl
EVENTS_PATH=data/real/events.jsonl
STATE_PATH=data/real/state.json
LOG_PATH=logs/tct-real.log

# Sesion de Telegram propia. Dos procesos NO pueden compartir el mismo archivo
# .session. La primera vez te va a pedir el codigo de nuevo: corre antes
#     tct chats --env-file .env.real
TELEGRAM_SESSION_NAME=telegram_copy_trading_real


# -------------------------------------------------------------------------
# 3) TELEGRAM  (los mismos datos que en el .env de siempre)
# -------------------------------------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SOURCE_CHATS=

# EL BOT NO ESCRIBE NADA. Lo pidio el usuario, dos veces y con estas palabras:
# "no quiero que ningun bot me avise si abrio o no, solo quiero que lea los
# mensajes del telegram y lo haga". No se lo vuelvas a proponer.
#
# No hay nada de avisos que completar: el sistema se saco del proyecto.
# Lo que eso significa, dicho una vez y no mas: si el freno diario salta o una
# orden no entra, no te enteras hasta que corras `tct informe`. Es la unica
# fuente. Y sin el control no hay freno desde el telefono: para parar el bot
# hay que cerrar la ventana en la PC.
#
# Los comandos (/pausa, /estado) NO son avisos: el bot solo contesta si vos le
# escribis primero. Si alguna vez queres el freno a mano, esto es lo unico que
# hay que cambiar:
#     ENABLE_TELEGRAM_CONTROL=true
TELEGRAM_CONTROL_CHAT=me
ENABLE_TELEGRAM_CONTROL=false

# CLAVE DE ARRANQUE. Obligatoria con dinero real: sin ella, este bot NO
# arranca. Se la pide cada vez que lo abris, antes de conectar nada.
#
# NO se escribe aca a mano. Se pone con este comando, que la pide dos veces
# sin mostrarla y deja en esta linea una huella (no la clave):
#     tct clave --env-file .env.real
# Si te la olvidas, corre el mismo comando y pone otra.
CLAVE_DE_ARRANQUE=


# -------------------------------------------------------------------------
# 4) LA CUENTA REAL DE MT5  -  BULLWAVES
# -------------------------------------------------------------------------
# La real va en BULLWAVES, con SU PROPIO MetaTrader: se baja de la web de
# Bullwaves y queda instalado en otra carpeta que el de FxPro. Cada bot le
# habla a su terminal, y la demo de FxPro puede seguir corriendo al lado.
#
# AL ABRIR LA CUENTA, QUE SEA HEDGING (cada operacion es su propia posicion).
# Con una NETTING el bot no opera: ahi una senal SELL cerraria el BUY de otra.
#
# EN ESTE ORDEN, porque `tct mt5` se conecta a la terminal de MT5_PATH:
#   1. La ruta del MetaTrader de Bullwaves: clic derecho en su acceso directo
#      -> Propiedades -> copiar 'Destino'. Se escribe esto y se pega el
#      Destino tal cual, pegado al '=' y con sus comillas:
#          tct cambiar --env-file .env.real MT5_PATH=
#   2. Con ese MetaTrader abierto y logueado en la cuenta REAL:
#          tct mt5 --env-file .env.real
#      Dice login, servidor, apalancamiento, si es HEDGING, como llama
#      Bullwaves al oro ("XAUUSD -> ...") y cuanto margen pide cada posicion.
#
# MT5_PATH es OBLIGATORIO aca: con varios MetaTrader en la PC, vacio se
# engancha al primero que encuentre, y el bot no arranca (no es la cuenta).
#
# La password es la MASTER, no la de inversor: esa no puede operar.
#
# PEGA LA RUTA SIN COMILLAS. Las comillas dobles convierten la barra seguida
# de t de \terminal64.exe en un tabulador, y el bot no encuentra la terminal.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_BROKER_PROFILE=bullwaves


# -------------------------------------------------------------------------
# 5) RIESGO  -  ACA ES DONDE SE DECIDE CUANTO PODES PERDER
# -------------------------------------------------------------------------
# Mas conservador que en la demo a proposito: en la demo un error cuesta un
# numero en una pantalla; aca cuesta plata.

# Lote de cada operacion. Lo eligio el usuario el 27/09, despues de probarlo
# unos dias en la demo de 500: "sin arriesgar poco pero tampoco demasiado".
#
# En oro, 0.01 es 1 onza y cada punto vale 1 dolar; 0.05 son 5 onzas y cada
# punto vale 5. Los stops de este canal son de 4 a 8 puntos, asi que:
#
#     0.01 -> cada stop cuesta 4 a 8      (0.8% a 1.6% de una cuenta de 500)
#     0.05 -> cada stop cuesta 20 a 40    (4% a 8% de una cuenta de 500)
DEFAULT_LOT=0.05

# Techo duro, y se verifica sobre el volumen que SALE, no sobre DEFAULT_LOT.
# Tiene que acompanar al de arriba: si DEFAULT_LOT lo supera, el broker recibe
# el rechazo del bot y no se abre nada.
MAX_LOT=0.05

# Una posicion por senal: la del TP1.
POSITIONS_PER_SIGNAL=1
MAX_POSITIONS_PER_SYMBOL=2

# El breakeven va al precio al que lleno la orden de verdad, no al del mensaje.
BREAKEVEN_USES_REAL_ENTRY=true

# CUANTAS POSICIONES A LA VEZ. Depende del APALANCAMIENTO de tu cuenta, que te
# lo dice 'tct mt5'. Con el oro a ~4430, una posicion de 0.05 pide de margen:
#
#     1:20   ~1110  -> en 500 NO entra ninguna
#     1:50   ~ 443  -> en 500 entra 1
#     1:100  ~ 222  -> en 500 entran 2
#     1:500  ~  44  -> en 500 entran 11
#
# Para 2 a la vez hace falta 1:90 o mas. Poner mas de las que entran no da mas
# operaciones: da ordenes rechazadas ('No money'), y 'tct mt5' lo avisa.
#
# La tabla vale si 1 lote de oro son 100 onzas, lo normal. Lo que manda es el
# margen que pide Bullwaves de verdad, y ese lo da 'tct mt5 --env-file .env.real'.
# El apalancamiento del ORO puede ser menor que el de la cuenta; el margen que
# muestra ese comando se lo pide al broker, asi que ya lo incluye.
MAX_OPEN_TRADES=2

# Tope de senales por dia. Si el grupo se desboca, esto lo frena.
# Medido en el canal: unas 3 por dia. 10 deja aire de sobra sin dejarlo
# suelto, y hace que el dia lo corte el freno de PLATA -el de abajo- y no
# un contador. Con 5, la 6a senal del dia se rechaza aunque no hayas
# perdido nada.
MAX_SIGNALS_PER_DAY=10

# Si la cuenta cae este % respecto del saldo con el que abrio el dia, deja de
# abrir operaciones hasta el dia siguiente. En 0 esta APAGADO.
#
# APAGADO a pedido del usuario (27/09): "sin freno ya que no abre muchas
# operaciones, con los SL esta bien". El razonamiento tiene respaldo en los
# datos -el canal manda unas 3 senales por dia y cada posicion sale con su
# stop puesto-, y es su decision.
#
# Lo que hay que saber igual, porque con lote 0.05 los numeros son otros:
#
#     un stop     = 20 a 40      (4% a 8% de 500)
#     un dia malo = 3 stops      = unos 120   (24% de 500)
#     el tope real de un dia lo pone ahora MAX_SIGNALS_PER_DAY, no este numero
#
# Con 5% (25 dolares) el freno cortaria al PRIMER stop, que es lo que lo hacia
# incompatible con este lote. Si algun dia se quiere prender, el numero tiene
# que ser coherente con el lote: con 0.05, algo entre 10% y 15%.
#
# OJO con lo que NO cubre, cuando este prendido: la referencia se toma al
# arrancar el bot. Si quedan posiciones abiertas de la noche anterior y la
# cuenta se mueve mientras el bot esta apagado, ese tramo no entra en la cuenta
# del dia.
MAX_DAILY_LOSS_PCT=0

# Nunca operar sin stop loss. Con dinero real esto no se discute.
REQUIRE_STOP_LOSS=true
REQUIRE_TAKE_PROFIT=true

# Cuanto puede alejarse la entrada del mensaje del precio REAL antes de
# rechazar la senal. Es la unica proteccion que ataja un error de LECTURA, y
# ademas frena las entradas TARDE: con 0.3 (unos 13 puntos en oro) entraron
# operaciones que arriesgaban ~11 para ganar ~1. 0.05 son unos 2 puntos, igual
# que la demo de FxPro. Saltea tambien alguna entrada buena; si la comparacion
# con MetaQuotes (sin filtro) dice que saltea de mas, se cambia aca Y en
# .env.segunda.
#
# OJO: se probo con los precios de FxPro, y la real va en Bullwaves. Si su
# precio del oro difiere del de FxPro, este mismo 0.05 rechaza otras senales.
# Si en `tct informe --env-file .env.real` aparecen rechazos por "precio real"
# que la demo de FxPro si tomo, el numero a revisar es este.
MAX_SPREAD_FROM_ENTRY_PCT=0.05
MAX_PENDING_DISTANCE_PCT=2.0

# Empeza con lo que ya viste funcionar: el oro es lo que opera este canal.
# BTCUSD queda afuera hasta mirar su margen en la cuenta real con
#     tct probar --env-file .env.real
ALLOWED_SYMBOLS=XAUUSD


# -------------------------------------------------------------------------
# 6) IA LOCAL
# -------------------------------------------------------------------------
# Con dinero real, OLLAMA_AUTO_EXECUTE se queda en false. Sin excepciones.
ENABLE_OLLAMA=true
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_AUTO_EXECUTE=false

DRY_RUN=false
